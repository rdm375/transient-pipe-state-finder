# Source code and scientific data use LF line endings.
*.cpp text eol=lf
*.hpp text eol=lf
*.h text eol=lf
*.py text eol=lf
*.md text eol=lf
*.txt text eol=lf
*.csv text eol=lf
*.json text eol=lf
*.cmake text eol=lf
CMakeLists.txt text eol=lf

# Binary assets.
*.png binary
*.jpg binary
*.jpeg binary
*.pdf binary
